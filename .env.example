# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# ---------------------------------------------------------------------------
# TigerGraph Savanna workspace (TigerGraph 4.2+, auto-stop and auto-start on).
# These names are the ones tigergraph-mcp and pyTigerGraph read.
# ---------------------------------------------------------------------------
TG_HOST=https://<workspace-id>.i.tgcloud.io
TG_GRAPHNAME=FraudTrail
TG_USERNAME=
TG_PASSWORD=
# Either the username/password pair above or a GSQL secret below is enough.
TG_SECRET=
TG_TGCLOUD=true
# Savanna serves REST++ and GSQL over 443; a local Community Edition uses 9000/14240.
TG_RESTPP_PORT=443
TG_GS_PORT=443

# ---------------------------------------------------------------------------
# The model that writes the case summary and the report narrative. It rewrites
# prose and nothing else: every identifier, amount and date it returns is checked
# against the evidence, and anything invented is dropped for the templated text.
#
# FRAUDTRAIL_LLM_PROVIDER is one of: anthropic, google, openai, none.
# With "none" the agent still runs and writes every answer file, from templates.
#
# Free tiers: google issues a key from AI Studio with no card. Any other
# OpenAI-compatible free endpoint works through provider "openai" plus
# FRAUDTRAIL_LLM_BASE_URL, for example https://openrouter.ai/api/v1.
# Copy the model id from the provider's console; do not guess it.
#
# A free tier also caps requests per model per day, sometimes below the 22 or so one
# run needs. FRAUDTRAIL_LLM_MODEL may list several models separated by commas; when
# one is spent for the day the run carries on with the next.
# ---------------------------------------------------------------------------
FRAUDTRAIL_LLM_PROVIDER=none
FRAUDTRAIL_LLM_MODEL=
FRAUDTRAIL_LLM_API_KEY=
FRAUDTRAIL_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Embeddings for GraphRAG. Runs locally by default (no key, no cost).
# ---------------------------------------------------------------------------
FRAUDTRAIL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Paths. Defaults match the repository layout.
# ---------------------------------------------------------------------------
FRAUDTRAIL_RAW_DIR=data/raw
FRAUDTRAIL_PROCESSED_DIR=data/processed
