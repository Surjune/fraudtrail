# Copy to .env and fill in. Never commit .env.

# TigerGraph Savanna workspace (names match what tigergraph-mcp reads)
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_GRAPHNAME=FraudTrail
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
TG_TGCLOUD=true

# LLM used for tool selection, evidence synthesis and explanations
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
