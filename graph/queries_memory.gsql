# GraphRAG retrieval and case write-back.
#
# Retrieval is hybrid on purpose: a vector search finds text that reads like this case,
# then the graph expands each hit into the cards, transactions and devices behind it, so
# the model receives connected evidence instead of loose paragraphs.

USE GRAPH FraudTrail

# Closed cases whose analyst notes read like this situation, expanded to what they touched.
# The search asks for more than it needs (overfetch) because the nearest notes may have
# been written after the alert being investigated, and an investigation may only use what
# the bank knew at the time. The caller keeps the k nearest of what survives that filter.
CREATE OR REPLACE QUERY similar_closed_cases(LIST<FLOAT> query_vec, INT k = 5,
    DATETIME before_ts = to_datetime("2017-01-01 00:00:00"), INT overfetch = 4)
    FOR GRAPH FraudTrail SYNTAX v2 {
  MapAccum<VERTEX, FLOAT> @@distance;
  MapAccum<STRING, STRING> @@card_of;
  Hits = vectorSearch({ClosedCase.notes_emb}, query_vec, k * overfetch,
                      {distance_map: @@distance});
  Recent = SELECT cc FROM Hits:cc WHERE cc.opened_at < before_ts;
  CaseCards = SELECT c FROM Recent:cc -(ON_CARD)- Card:c
              ACCUM @@card_of += (cc.case_id -> c.card_id);
  Txns = SELECT t FROM Recent:cc -(INVOLVES)- Transaction:t;
  PRINT Recent AS cases, @@distance AS distance, @@card_of AS card_of,
        Txns AS transactions;
}

# The closed-case corpus, read once so retrieval can rank it on the analysts' own words.
# This is what answers "which case reads like this one" until the notes carry embeddings;
# after that similar_closed_cases above does the same job in one hop.
CREATE OR REPLACE QUERY closed_case_notes(DATETIME before_ts, INT max_cases = 8000)
    FOR GRAPH FraudTrail SYNTAX v2 {
  MapAccum<STRING, STRING> @@card_of;
  Cases = SELECT cc FROM ClosedCase:cc WHERE cc.opened_at < before_ts
          ORDER BY cc.opened_at DESC LIMIT max_cases;
  CaseCards = SELECT c FROM Cases:cc -(ON_CARD)- Card:c
              ACCUM @@card_of += (cc.case_id -> c.card_id);
  PRINT Cases AS cases, @@card_of AS card_of;
}

# Policy, pattern and regulatory text for the model to ground its wording in.
CREATE OR REPLACE QUERY doc_search(LIST<FLOAT> query_vec, INT k = 5)
    FOR GRAPH FraudTrail SYNTAX v2 {
  MapAccum<VERTEX, FLOAT> @@distance;
  Hits = vectorSearch({DocChunk.content_emb}, query_vec, k, {distance_map: @@distance});
  PRINT Hits AS chunks, @@distance AS distance;
}

# This agent's own earlier investigations: memory it wrote during this run.
CREATE OR REPLACE QUERY similar_investigations(LIST<FLOAT> query_vec, INT k = 5)
    FOR GRAPH FraudTrail SYNTAX v2 {
  MapAccum<VERTEX, FLOAT> @@distance;
  Hits = vectorSearch({InvestigationCase.summary_emb}, query_vec, k, {distance_map: @@distance});
  Cards = SELECT c FROM Hits:i -(INV_ON_CARD)- Card:c;
  PRINT Hits AS cases, @@distance AS distance, Cards AS cards;
}

# Store an investigation as case memory: the case itself, what it touched, and the
# patterns and prior cases it drew on.
CREATE OR REPLACE QUERY write_case(STRING case_id, STRING exam_case_id, STRING trigger_type,
    STRING status, STRING verdict, DOUBLE fraud_probability, STRING pattern,
    STRING pattern_description, DOUBLE exposure_usd, STRING summary, BOOL report_filed,
    DATETIME opened_at, STRING card, STRING flagged_txn, SET<STRING> affected_txns,
    SET<STRING> connected_cards, SET<STRING> device_profiles, SET<STRING> prior_cases)
    FOR GRAPH FraudTrail SYNTAX v2 {
  INSERT INTO InvestigationCase VALUES (case_id, exam_case_id, trigger_type, status, verdict,
      fraud_probability, pattern, pattern_description, exposure_usd, summary, report_filed,
      opened_at, now());
  INSERT INTO INV_ON_CARD VALUES (case_id, card);
  INSERT INTO INV_FLAGGED VALUES (case_id, flagged_txn);
  IF pattern != "none" THEN
    INSERT INTO INV_PATTERN VALUES (case_id, pattern);
  END;
  FOREACH t IN affected_txns DO
    INSERT INTO INV_AFFECTS VALUES (case_id, t);
  END;
  FOREACH c IN connected_cards DO
    INSERT INTO INV_CONNECTED_CARD VALUES (case_id, c);
  END;
  FOREACH d IN device_profiles DO
    INSERT INTO INV_DEVICE VALUES (case_id, d);
  END;
  FOREACH p IN prior_cases DO
    INSERT INTO INV_SIMILAR_CLOSED VALUES (case_id, p);
  END;
  PRINT case_id AS written;
}

# One step of an investigation: the tool call, the evidence request, the decision. The
# case's progression can be replayed from these.
CREATE OR REPLACE QUERY write_case_event(STRING case_id, STRING event_id, INT step,
    STRING kind, STRING detail, DATETIME at) FOR GRAPH FraudTrail SYNTAX v2 {
  INSERT INTO CaseEvent VALUES (event_id, step, kind, detail, at);
  INSERT INTO HAS_EVENT VALUES (case_id, event_id);
  PRINT event_id AS written;
}

# Everything stored about one investigation, for the UI and for the next investigation.
CREATE OR REPLACE QUERY read_case(VERTEX<InvestigationCase> case_id) FOR GRAPH FraudTrail SYNTAX v2 {
  Seed = {case_id};
  Events = SELECT e FROM Seed:i -(HAS_EVENT)- CaseEvent:e ORDER BY e.step ASC;
  Affected = SELECT t FROM Seed:i -(INV_AFFECTS)- Transaction:t;
  Connected = SELECT c FROM Seed:i -(INV_CONNECTED_CARD)- Card:c;
  Prior = SELECT cc FROM Seed:i -(INV_SIMILAR_CLOSED)- ClosedCase:cc;
  PRINT Seed AS investigation, Events AS events, Affected AS affected,
        Connected AS connected_cards, Prior AS prior_cases;
}

# One investigation and the evidence around it, for the dashboard's graph: the card it was
# opened on and its owner, the owner's other cards, the transactions it flagged and affected
# with the device and billing region of each, the linked cards and the case device each one
# used, and the closed cases it drew on with the card each was opened on.
CREATE OR REPLACE QUERY case_graph(VERTEX<InvestigationCase> case_id, INT max_owner_cards = 25)
    FOR GRAPH FraudTrail SYNTAX v2 {
  MapAccum<STRING, STRING> @@card_of;
  MapAccum<STRING, STRING> @@device_of;
  MapAccum<STRING, STRING> @@region_of;
  MapAccum<STRING, STRING> @@closed_case_card;
  MapAccum<STRING, SetAccum<STRING>> @@linked_on_device;
  OrAccum @on_case;
  MinAccum<STRING> @linked_card;
  Seed = {case_id};
  CaseCard = SELECT c FROM Seed:i -(INV_ON_CARD)- Card:c;
  Owner = SELECT cu FROM CaseCard:c -(OWNS)- Customer:cu;
  OwnerCards = SELECT c FROM Owner:cu -(OWNS)- Card:c ORDER BY c.card_id ASC
               LIMIT max_owner_cards;
  Flagged = SELECT t FROM Seed:i -(INV_FLAGGED)- Transaction:t;
  Affected = SELECT t FROM Seed:i -(INV_AFFECTS)- Transaction:t;
  Txns = Flagged UNION Affected;
  TxnCards = SELECT c FROM Txns:t -(MADE)- Card:c ACCUM @@card_of += (t.txn_id -> c.card_id);
  TxnDevices = SELECT d FROM Txns:t -(FROM_DEVICE)- DeviceProfile:d
               ACCUM @@device_of += (t.txn_id -> d.profile_id);
  CaseDevices = SELECT d FROM Seed:i -(INV_DEVICE)- DeviceProfile:d;
  Devices = TxnDevices UNION CaseDevices;
  Devices = SELECT d FROM Devices:d POST-ACCUM d.@on_case += TRUE;
  Regions = SELECT r FROM Txns:t -(BILLED_IN)- BillingRegion:r
            ACCUM @@region_of += (t.txn_id -> r.region);
  Linked = SELECT c FROM Seed:i -(INV_CONNECTED_CARD)- Card:c;
  LinkedTxns = SELECT t FROM Linked:c -(MADE)- Transaction:t ACCUM t.@linked_card += c.card_id;
  Shared = SELECT d FROM LinkedTxns:t -(FROM_DEVICE)- DeviceProfile:d WHERE d.@on_case
           ACCUM @@linked_on_device += (d.profile_id -> t.@linked_card);
  Prior = SELECT cc FROM Seed:i -(INV_SIMILAR_CLOSED)- ClosedCase:cc;
  PriorCards = SELECT c FROM Prior:cc -(ON_CARD)- Card:c
               ACCUM @@closed_case_card += (cc.case_id -> c.card_id);
  PRINT Seed AS investigation, CaseCard AS card, Owner AS owner, OwnerCards AS owner_cards,
        Flagged AS flagged, Affected AS affected, Devices AS devices, Regions AS regions,
        Linked AS linked_cards, Prior AS prior_cases, @@card_of AS card_of,
        @@device_of AS device_of, @@region_of AS region_of,
        @@linked_on_device AS linked_on_device, @@closed_case_card AS closed_case_card;
}
