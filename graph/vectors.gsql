# Vector attributes for GraphRAG retrieval. Run after schema.gsql.
# 384 dimensions matches the local embedding model (BAAI/bge-small-en-v1.5).

CREATE GLOBAL SCHEMA_CHANGE JOB add_vectors {
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE notes_emb(DIMENSION=384, METRIC="COSINE");
  ALTER VERTEX InvestigationCase ADD VECTOR ATTRIBUTE summary_emb(DIMENSION=384, METRIC="COSINE");
  ALTER VERTEX DocChunk ADD VECTOR ATTRIBUTE content_emb(DIMENSION=384, METRIC="COSINE");
}
RUN GLOBAL SCHEMA_CHANGE JOB add_vectors
